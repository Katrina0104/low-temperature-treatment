      \"\u8108\u640F52\u6B21/\u5206\" \"\u547C\u5438\u983B\u7387\uFF1A15\u6B21/\u5206\u9418\"
      \"\u8840\u58D3178/88mmHg\" \u662F\u5426\u53EF\u4EE5\u9032\u884C\u6CBB\u7642\uFF1F\u751F\u547D\u9AD4\u5FB5\u7686\u5728\u6B63\u5E38\u7BC4\u570D\u5167\u3002\u518D\u60F3\u4E00\u4E0B\uFF01\u63A5\u4E0B\u4F86\uFF0C\u6211\u5011\u4F86\u78BA\u8A8D\u683C\u62C9\u65AF\u54E5\u660F\u8FF7\u8A55\u5206\uFF08GCS\uFF09\u662F\u5426\u5C0F\u65BC\u7B49\u65BC12\u3002\"\u5F35\u5C0F\u540D\uFF0C\u8ACB\u775C\u958B\u773C\u775B\"\u300C\u96D9\u773C\u7DCA\u9589\u6C92\u6709\u775C\u958B\u300DGCS
      5T\uFF0CE1VTM4\u3002\u5979\u9700\u8981\u6CBB\u7642\u2026\u73FE\u5728\uFF0C\u6211\u5011\u4F86\u78BA\u8A8D\u9871\u5167\u58D3(ICP)\u6578\u503C\u662F\u5426\u5927\u65BC20mmHg\u3002\u89C0\u5BDF\u9871\u5167\u58D3(ICP)\u5100\u5668\u3002\"ICP\u6578\u503C\uFF0C\u9871\u5167\u58D330mmHg\"
      \u73FE\u5728\u6211\u5011\u4F7F\u7528\u98DF\u9053\u6EAB\u63A2\u982D\u6838\u5FC3\u9AD4\u6EAB\uFF08\u6211\u5011\u53EF\u4EE5\u5C07\u63A2\u982D\u9023\u63A5\u5230\u98DF\u9053\u3001\u8180\u80F1\u6216\u76F4\u8178\uFF09\u3002\r\n\u6CE8\u610F\u4E8B\u9805\uFF01\u300C\u5982\u679C\u9032\u5165\u98DF\u9053\u300D\u8ACB\u5C07\u63A2\u982D\u63A8\u9032\u81F3\u98DF\u9053\u4E2D\u4E0B\u4E09\u5206\u4E4B\u4E00\u8655\u3002\u6B64\u4F4D\u7F6E\u53EF\u6E96\u78BA\u6E2C\u91CF\u6838\u5FC3\u9AD4\u6EAB\u3002\u300C\u5982\u679C\u9032\u5165\u8180\u80F1\u300D\u8ACB\u4F7F\u7528\u8207\u63D2\u5165\u6A19\u6E96\u5C0E\u5C3F\u7BA1\u76F8\u540C\u7684\u7121\u83CC\u6280\u8853\u63D2\u5165\u63A2\u982D\u3002\u300C\u5982\u679C\u9032\u5165\u76F4\u8178\u300D\u82E5\u60A3\u8005\u70BA\u6210\u4EBA\u8981\u63D2\u5165\u81F3\u5C116.5cm\u3001\u65B0\u751F\u5152\u81F3\u5C11\u8981\u63D2\u51653cm\u3001\u65E9\u7522\u5152\u81F3\u5C11\u8981\u63D2\u51652cm\u3002\u300C\u60A3\u8005\u76EE\u524D\u9F13\u819C\u6EAB\u5EA6\u70BA
      36.8\xB0C\u3002\u300D\u4E00\u5207\u6E96\u5099\u5C31\u7DD2\u6E96\u5099\u958B\u59CB\u4F4E\u6EAB\u6CBB\u7642\u3002\r\n\u63A5\u8457\u9078\u64C7\u6EAB\u63A7\u50B3\u905E\u588A\uFF0C\u8981\u6839\u64DA\u60A3\u8005\u9AD4\u91CD\u9078\u64C7\u4E0D\u540C\u578B\u865F\uFF0C\u76EE\u6A19\u662F\u8986\u84CB\u767E\u5206\u4E4B\u56DB\u5341\u8DB4\u7684\u8EAB\u9AD4\u8868\u9762\u7A4D\u3002\u300C\u75C5\u4EBA65\u516C\u65A4\uFF0C\u9078\u64C7\u5C0D\u61C9M\u578B\u865F\u7684\u8CBC\u7247\u4E26\u8CBC\u4E0A\u5728\u75C5\u4EBA\u8EAB\u4E0A\u300D\"\u8ACB\u5C07\u5730\u4E0A\u7684\u6EAB\u63A7\u50B3\u905E\u588A\u62FF\u8D77\u9032\u884C\u7A7F\u6234\"
      \u5730\u677F\u4E0A\u7684\u85CD\u8272\u8CBC\u7247\u70BA\u6EAB\u63A7\u50B3\u905E\u588A\uFF0C\u8ACB\u653E\u5230\u75C5\u4EBA\u8EAB\u4E0A\u9032\u884C\u7A7F\u6234\u3002\u975E\u5E38\u597D\uFF0C\u6700\u5F8C\u53EA\u9700\u8981\u63A5\u4E0A\u8F38\u6C34\u7BA1\u5C31\u53EF\u4EE5\u4E86\u3002\u9023\u63A5\u7684\u6642\u5019\u8A18\u5F97\u9023\u63A5\u7684\u6642\u5019\u8A18\u5F97\u624B\u63E1\u85CD\u8272\u7BA1\u4E26\u5C0D\u6E96\u96D9\u5B54\u6D1E\uFF0C\u7136\u5F8C\u5411\u524D\u63A8\u9032\u7DCA\u6263\u5169\u5074\u5361\u69AB\u3002\u6CE8\u610F\u6D41\u901F\u4E0D\u80FD\u4F4E\u65BC2L/min\uFF0C\u9084\u6709\u7BA1\u8DEF\u4E0D\u53EF\u4EE5\u6709\u66F2\u6298\u3002\"\u8ACB\u6309\u4E0B\u7246\u58C1\u4E0A\u7684\u6309\u9215\u9032\u884C\u8F38\u6C34\u7BA1\u7684\u9023\u63A5\"
      \u505A\u5F97\u4E0D\u932F\uFF0C\u73FE\u5728\u53EF\u4EE5\u958B\u59CB\u5728\u5100\u5668\u4E0A\u8A2D\u5B9A\u7642\u7A0B\u4E86\u3002\u7246\u58C1\u4E0A\u7684\u6309\u9215\u70BA\u8F38\u6C34\u7BA1\u7684\u9023\u63A5\u65B9\u5F0F\uFF0C\u8ACB\u6309\u4E0B\u7E7C\u7E8C\u7642\u7A0B\u3002\r\n\u5E6B\u6211\u627E\u5230\u4F4E\u6EAB\u6CBB\u7642\u5100\u5668\uFF0C\u4E26\u958B\u59CB\u964D\u6EAB\u7642\u7A0B\u3002\"\u8ABF\u6574\u964D\u6EAB\u6578\u503C\u81F333\u5EA6\"
      \u8ACB\u8A18\u5F97\u505A\u5132\u5B58\u3002\u6EAB\u5EA6\u5DF2\u9054\u5230 33.0
      \u5EA6\uFF0C\u505A\u5F97\u597D\u3002\u6EAB\u5EA6\u9084\u6C92\u5C0D\u5594\uFF0C\u76EE\u524D\u986F\u793A\u7684\u4E0D\u662F
      33.0 \u5EA6\u3002\u5F88\u597D\uFF0C\u7642\u7A0B\u9032\u884C\u7684\u9019\u5E7E\u5929\u8981\u6CE8\u610F\u4EE5\u4E0B\u4E8B\u9805\uFF1A\u8840\u7CD6\u7BA1\u7406
      (Blood Glucose Management)\uFF1A\u4F4E\u6EAB\u6703\u6E1B\u5C11\u80F0\u5CF6\u7D20\u5206\u6CCC\u4E26\u964D\u4F4E\u80F0\u5CF6\u7D20\u654F\u611F\u6027\uFF0C\u53EF\u80FD\u5C0E\u81F4\u9AD8\u8840\u7CD6\uFF0C\u6216\u8A31\u9700\u8981\u4F7F\u7528\u80F0\u5CF6\u7D20\u8F38\u6CE8\u3002\u8B77\u7406\u898F\u7D04\u4E2D\u901A\u5E38\u5305\u542B\u80F0\u5CF6\u7D20\u898F\u7D04\u3002\r\n\u51DD\u8840\u529F\u80FD\u8207\u51FA\u8840\u98A8\u96AA
      (Coagulation and Bleeding Risk)\uFF1A\u4F4E\u6EAB\u6703\u640D\u5BB3\u51DD\u8840\u529F\u80FD\u548C\u8840\u5C0F\u677F\u529F\u80FD\u3002\u9AD4\u6EAB\u4F4E\u65BC
      35\xB0C \u53EF\u80FD\u6703\u5C0E\u81F4\u8F15\u5EA6\u8840\u5C0F\u677F\u529F\u80FD\u53D7\u640D\u548C\u8840\u5C0F\u677F\u8A08\u6578\u4E0B\u964D\uFF1B\u9AD4\u6EAB\u4F4E\u65BC
      33\xB0C \u5F71\u97FF\u66F4\u5927\u3002\u9AD4\u6EAB\u4F4E\u65BC 30\xB0C \u6642\u51FA\u8840\u98A8\u96AA\u986F\u8457\u589E\u52A0\u3002\u5C0D\u65BC\u6709\u51DD\u8840\u529F\u80FD\u969C\u7919\u6216\u51FA\u8840\u98A8\u96AA\u7684\u75C5\u60A3\uFF0C\u9700\u8981\u5BC6\u5207\u76E3\u6E2C\u3002\u514D\u75AB\u7CFB\u7D71\u8207\u611F\u67D3\u98A8\u96AA
      (Immune System and Infection Risk)\uFF1A\u4F4E\u6EAB\u53EF\u80FD\u5C0E\u81F4\u514D\u75AB\u7CFB\u7D71\u529F\u80FD\u4E0B\u964D\uFF0C\u589E\u52A0\u611F\u67D3\u98A8\u96AA\uFF0C\u7279\u5225\u662F\u547C\u5438\u5668\u76F8\u95DC\u6027\u80BA\u708E
      (VAP)\u3002\u9810\u9632\u6027\u7684\u6297\u751F\u7D20\u7642\u7A0B\u53EF\u80FD\u6703\u6709\u76CA\u3002\r\n\u5FC3\u5F8B\u4E0D\u6574
      (Arrhythmias)\uFF1A\u5728 TTM \u671F\u9593\u76F8\u5C0D\u5E38\u898B\u3002\u5FC3\u8DF3\u904E\u7DE9
      (Bradycardia) \u662F\u6700\u5E38\u898B\u7684\u3002\u901A\u5E38\u53EA\u6709\u5728\u5F71\u97FF\u75C5\u60A3\u7684\u8840\u6D41\u52D5\u529B\u5B78\u6642\u624D\u9700\u8981\u6CBB\u7642\u3002\u4E5F\u53EF\u80FD\u51FA\u73FE\u5FC3\u623F\u986B\u52D5
      (Af) \u6216\u8F03\u5C11\u898B\u7684\u5FC3\u5BA4\u983B\u8108 (VT)\u3002\u610F\u8B58\u72C0\u614B
      (Consciousness Level)\uFF1A\u5982\u679C\u75C5\u60A3\u5728\u7642\u7A0B\u7D50\u675F\u524D\u6062\u5FA9\u610F\u8B58\u4E14\u4E0D\u518D\u660F\u8FF7\uFF0C\u53EF\u80FD\u9700\u8981\u7D50\u675F\u7642\u7A0B\u3002\u4E0D\u61C9\u5C0D\u6C92\u6709\u660F\u8FF7\u7684\u75C5\u60A3\u9032\u884C\u4F4E\u6EAB\u6CBB\u7642\u3002\u96FB\u89E3\u8CEA\u8207\u6DB2\u9AD4\u5E73\u8861
      (Electrolytes and Fluid Balance)\uFF1A\u4F4E\u6EAB\u53EF\u80FD\u5C0E\u81F4\u8F15\u5EA6\u7684\u5229\u5C3F\u548C\u96FB\u89E3\u8CEA\u6D41\u5931\uFF0C\u4F8B\u5982\u4F4E\u8840\u9240\u3001\u4F4E\u8840\u9382\u548C\u4F4E\u8840\u9223\u3002\u9019\u53EF\u80FD\u5C0E\u81F4\u4F4E\u8840\u5BB9\u91CF\u3002\u56E0\u6B64\uFF0C\u9700\u8981\u62BD\u8840\u6AA2\u67E5\u4E26\u6839\u64DA\u9700\u8981\u88DC\u5145\u96FB\u89E3\u8CEA\u3002\u7279\u5225\u6CE8\u610F\uFF0C\u5FA9\u6EAB\u968E\u6BB5\u6703\u9006\u8F49\u9240\u96E2\u5B50\u6D41\u52D5\uFF0C\u53EF\u80FD\u5C0E\u81F4\u9AD8\u8840\u9240\uFF0C\u56E0\u6B64\u5728\u5FA9\u6EAB\u524D
      4 \u5C0F\u6642\uFF0C\u7279\u5225\u662F\u814E\u529F\u80FD\u4E0D\u5168\u7684\u75C5\u60A3\uFF0C\u61C9\u66AB\u505C\u9240\u96E2\u5B50\u88DC\u5145\u3002\r\n\u7642\u7A0B\u5C1A\u672A\u7D50\u675F\uFF0C\u8ACB\u591A\u95DC\u6CE8\u60A3\u8005\u60C5\u6CC1\u3002\"\u8ACB\u5B8C\u6210\u6BCF\u65E5\u4F8B\u884C\u884C\u7A0B\"
      \u4E0D\u9700\u8981\u91CD\u65B0\u63A5\u8F38\u6C34\u7BA1\u55CE\uFF1F\u975E\u5E38\u597D~\u91CD\u65B0\u63A5\u8F38\u6C34\u7BA1\u4E0D\u662F\u6BCF\u65E5\u4F8B\u884C\u516C\u4E8B\u3002\u9664\u975E\u6709\u9023\u63A5\u4E0D\u826F\uFF01\u5426\u5247\u4E0D\u9700\u8981\u3002\u9700\u8981\u5857\u62B9\u4E73\u6DB2\u55CE?
      \u662F\u7684!\u7279\u5225\u662F\u4F7F\u7528\u5916\u90E8\u51B7\u537B\u8CBC\u7247\u6642\uFF0C\u7531\u65BC\u8868\u9762\u5FAE\u8840\u7BA1\u8840\u6D41\u6E1B\u5C11\uFF0C\u75C5\u60A3\u76AE\u819A\u7834\u640D\u7684\u98A8\u96AA\u589E\u52A0\u3002\u9700\u8981\u983B\u7E41\u8A55\u4F30\u8CBC\u7247\u4E0B\u7684\u76AE\u819A\uFF0C\u4FDD\u8B77\u9AA8\u7A81\u8655\uFF0C\u4E26\u4F7F\u7528\u9069\u7576\u7684\u4E73\u6DB2\uFF0C\u5B9A\u671F\u7FFB\u8EAB\u4EE5\u964D\u4F4E\u98A8\u96AA\u3002\u4F7F\u7528\u5916\u90E8\u51B7\u537B\u8CBC\u7247\u6642\uFF0C\u7531\u65BC\u8868\u9762\u5FAE\u8840\u7BA1\u8840\u6D41\u6E1B\u5C11\uFF0C\u75C5\u60A3\u76AE\u819A\u7834\u640D\u7684\u98A8\u96AA\u589E\u52A0\u3002\u8ACB\u518D\u601D\u8003\u4E00\u4E0B!
      \u53EF\u4EE5\u5728\u7167\u9867\u60A3\u8005\u6642\uFF0C\u89C0\u770B\u6CBB\u7642\u624B\u518A!
      \u606D\u559C\u4ECA\u65E5\u4EFB\u52D9\u5B8C\u6210\u3002\r\n\u4F86\u6E2C\u91CF\u4ECA\u65E5\u60A3\u8005\u9AD4\u6EAB\u3002\u60A3\u8005\u76EE\u524D\u9F13\u819C\u6EAB\u5EA6\u70BA
      37.3\xB0C\u3002 36.5\xB0C\u3002\u8ACB\u554F\u662F\u5426\u6B63\u5E38? \u9F13\u819C\u6EAB\u5EA636.5\u2103\u81F337.8\u7686\u70BA\u6B63\u5E38\u3002\"\u8ACB\u5B8C\u6210\u6BCF\u65E5\u4F8B\u884C\u884C\u7A0B\"\r\n\u4F60\u8868\u73FE\u7684\u5F88\u68D2\uFF01\u73FE\u5728\u7642\u7A0B\u7D50\u675F\u9700\u8981\u79FB\u9664\u8F38\u6C34\u7BA1\uFF0C\u9996\u5148\u505C\u6B62\u6A5F\u5668\u7684\u6CBB\u7642\u7A0B\u5E8F\u3002\u6309\u4E0B\u87A2\u5E55\u4E0A\u7684stop\u6309\u9215\u5C31\u53EF\u4EE5\u4E86\u3002\u518D\u4F86\u628A\u50B3\u905E\u588A\u6392\u7A7A\uFF0C\u6309\u4E0B\u87A2\u5E55\u4E0A\u7684\u6392\u7A7A\u8CBC\u7247\u6309\u9215\u5C31\u53EF\u4EE5\u4E86\u3002\u63A5\u8457\u65B7\u958B\u9AD4\u6EAB\u63A2\u982D\u548C\u98DF\u9053\u6EAB\u63A2\u982D\u3002\u7136\u5F8C\u8981\u628A\u8F38\u6C34\u7BA1\u5F9E\u8DDF\u6A5F\u5668\u9023\u63A5\u7684\u7AEF\u982D\u79FB\u9664\uFF0C\u9996\u5148\u6293\u4F4F\u9023\u63A5\u8655\u7684\u7FFC\u72C0\u7D50\u69CB
      (wings)\u3002\u7136\u5F8C\u634F\u4F4F (pinch)\uFF0C\u63A8\u5165 (push)\uFF0C\u63A5\u8457\u518D\u62C9\u51FA
      (pull) \u4EE5\u79FB\u9664\u51DD\u81A0\u8CBC\u7247\uFF0C\u8A18\u5F97\u9700\u8981\u5C0D\u6240\u6709\u9023\u63A5\u7684\u8CBC\u7247\u91CD\u8907\u9019\u500B\u904E\u7A0B\u3002\u6700\u5F8C\u79FB\u9664\u60A3\u8005\u8EAB\u4E0A\u7684\u8CBC\u7247\u5C31\u5B8C\u6210\u4E86\u3002\u8981\u5C0F\u5FC3\u5730\u79FB\u9664\u907F\u514D\u6495\u88C2\u60A3\u8005\u7684\u76AE\u819A\u3002\r\n\u8B66\u544A\u8207\u7279\u6B8A\u4E8B\u4EF6\u6587\u5B57\uFF1A
      \u3010\u8B66\u544A\u3011\u5075\u6E2C\u5230\u8CBC\u7247\u812B\u843D\u6216\u8A2D\u5099\u7F3A\u6C34\uFF0C\u8ACB\u6AA2\u67E5\u9023\u7DDA\uFF01\u8ACB\u5148\u4F7F\u7528\"empty
      pads\" (\u6E05\u7A7A\u8CBC\u7247) \u6309\u9215\u4F86\u6E05\u7A7A\u8CBC\u7247\u5167\u7684\u6DB2\u9AD4\u3002\u73FE\u5728\u8ACB\u300C\u65B7\u958B\u8CBC\u7247\u8207\u6A5F\u5668\u9023\u63A5\u300D\u3002\u4E8B\u4EF6\u5DF2\u89E3\u6C7A\u3002\"\u5982\u679C\u6A5F\u5668\u986F\u793A\u7F3A\u6C34\uFF0C\u9700\u8981\u4F7F\u7528
      \"fill reservoir\" (\u586B\u5145\u6C34\u7BB1) \u529F\u80FD\u88DC\u5145\u7121\u83CC\u6C34\"
      \u73FE\u5728\u8ACB\u300C\u63A5\u56DE\u8CBC\u7247\u8207\u6A5F\u5668\u9023\u63A5\u300D\u3002\u7246\u58C1\u4E0A\u7684\u6309\u9215\u70BA\u5207\u65B7\u8F38\u6C34\u7BA1\u7684\u9023\u63A5\u65B9\u5F0F\uFF0C\u8ACB\u6309\u4E0B\u9032\u884C\u6AA2\u67E5\u3002\r\n\u3010\u8B66\u544A\u3011\u60A3\u8005\u8EAB\u9AD4\u51FA\u73FE\u98A4\u6296\u7684\u60C5\u6CC1\u3002\"\u53EF\u4EE5\u63A1\u53D6\u7B56\u7565\u8655\u7406\uFF0C\u5305\u62EC\uFF1A\u5C0D\u81C9\u90E8\u3001\u624B\u3001\u8173\u9032\u884C\u76AE\u819A\u6EAB\u6696\uFF08\u7528\u6EAB\u6BEF\u5305\u88F9\uFF09\"
      \"\u7D66\u4E88\u786B\u9178\u9382\uFF08\u85E5\u7269\uFF09\u4EE5\u63D0\u9AD8\u986B\u6296\u95BE\u503C\uFF1B\u4F7F\u7528\u6B62\u75DB\u85E5\u548C\u93AE\u975C\u5291\uFF08\u63A8\u6CE8\u6216\u6301\u7E8C\u8F38\u6CE8\uFF09\"
      \"\u5982\u679C\u4E0A\u8FF0\u65B9\u6CD5\u7121\u6548\uFF0C\u53EF\u80FD\u9700\u8981\u4F7F\u7528\u9EBB\u9189\u85E5\u7269\"\u3002\u662F\u5426\u7D66\u4E88\u786B\u9178\u9382?
      \u5DF2\u9078\u64C7\u63D0\u9AD8\u986B\u6296\u95BE\u503C\u3002\u662F\u5426\u7D66\u4E88\u6B62\u75DB\u85E5?
      \u5DF2\u9078\u64C7\u6B62\u75DB\u85E5\u7A69\u5B9A\u60A3\u8005\u3002\u8ACB\u5728\u5169\u7A2E\u65B9\u5F0F\u4E2D\u9032\u884C\u9078\u64C7\u3002\r\n\u3010\u8B66\u544A\u3011\u5075\u6E2C\u5230\u8840\u58D3\u4E0D\u7A69\u7684\u72C0\u6CC1\uFF01\u8ACB\u8ABF\u6574\u5FA9\u6EAB\u6578\u503C\u3002\u8ACB\u5C07\u5FA9\u6EAB\u6EAB\u5EA6\u9078\u70BA37\u5EA6\u3002\u6EAB\u5EA6\u5DF2\u8A2D\u7F6E\u70BA
      37.0 \u5EA6\uFF0C\u505A\u5F97\u597D\u3002\u6EAB\u5EA6\u9084\u6C92\u5C0D\u5594\uFF0C\u76EE\u524D\u986F\u793A\u7684\u4E0D\u662F
      37.0 \u5EA6\u3002\u518D\u5C07\u5FA9\u6EAB\u901F\u7387\u9078\u70BA0.25\u3002\u8A18\u5F97\u8ABF\u6574\u6B63\u4E0B\u65B9\u6642\u9593\u3002\"\u8ACB\u5132\u5B58\u6240\u6709\u8ABF\u6574\"
      \u5FA9\u6EAB\u901F\u7387\u5DF2\u8A2D\u7F6E\u70BA 0.25\uFF0C\u505A\u5F97\u597D\u3002\u5FA9\u6EAB\u901F\u7387\u9084\u6C92\u5C0D\u5594\uFF0C\u76EE\u524D\u986F\u793A\u7684\u4E0D\u662F
      0.25\u3002\r\n\u4F60\u5DF2\u7D93\u6210\u9577\u70BA\u4E00\u500B\u512A\u79C0\u7684\u8B77\u58EB\u4E86\uFF0C\u606D\u559C\u4F60\r\n\u6578\u91CF\u8ABF\u6162\u8D85\u8C61\u2103/hr.
      \u9700\r\n\r\n\u3010\u81E8\u5E8A\u516C\u544A\u3011\u6A19\u9776\u9AD4\u6EAB\u7BA1\u7406
      (TTM) \u8B77\u7406\u9808\u77E5\r\n1. \u7642\u7A0B\u76EE\u6A19\r\n\r\n\u900F\u904E\u964D\u4F4E\u60A3\u8005\u6838\u5FC3\u9AD4\u6EAB\u81F3
      32\xB0C - 36\xB0C\uFF0C\u964D\u4F4E\u8166\u90E8\u4EE3\u8B1D\u7387\uFF0C\u6E1B\u8F15\u7F3A\u6C27\u5F8C\u640D\u50B7\u3002\r\n\r\n2.
      \u4E09\u5927\u968E\u6BB5\u57F7\u884C\u8981\u9EDE\r\n\r\n\u8A98\u5C0E\u671F
      (Induction)\uFF1A \u9700\u5728\u6700\u77ED\u6642\u9593\u5167\u5C07\u9AD4\u6EAB\u964D\u81F3\u76EE\u6A19\u503C\u3002\u8ACB\u96A8\u6642\u76E3\u6E2C\u6838\u5FC3\u6EAB\u5EA6\uFF08\u98DF\u9053\u6216\u8180\u80F1\u6EAB\uFF09\u3002\r\n\r\n\u7DAD\u6301\u671F
      (Maintenance)\uFF1A \u6301\u7E8C\u7A69\u5B9A\u76EE\u6A19\u9AD4\u6EAB 24 \u5C0F\u6642\u3002\u6CE8\u610F\u75C5\u60A3\u662F\u5426\u6709\u986B\u6296
      (Shivering) \u53CD\u61C9\uFF0C\u5FC5\u8981\u6642\u7D66\u4E88\u85E5\u7269\u5E72\u9810\u3002\r\n\r\n\u56DE\u6EAB\u671F
      (Rewarming)\uFF1A \u56B4\u683C\u63A7\u5236\u56DE\u6EAB\u901F\u5EA6\uFF0C\u5EFA\u8B70\u70BA\u6BCF\u5C0F\u6642
      0.25\xB0C\uFF0C\u907F\u514D\u56DE\u6EAB\u904E\u5FEB\u5C0E\u81F4\u9871\u5167\u58D3\u5347\u9AD8\u3002\r\n\r\n3.
      \u5B89\u5168\u76E3\u6E2C\u91CD\u9EDE\r\n\r\n\u76AE\u819A\u5B8C\u6574\u6027\uFF1A
      \u96A8\u6642\u6AA2\u67E5\u80FD\u91CF\u50B3\u5C0E\u588A (Cooling Pads) \u4E0B\u7684\u76AE\u819A\u72C0\u6CC1\u3002\r\n\r\n\u96FB\u89E3\u8CEA\u5E73\u8861\uFF1A
      \u964D\u6EAB\u8207\u56DE\u6EAB\u904E\u7A0B\u4E2D\uFF0C\u8840\u9240\u6FC3\u5EA6\u53EF\u80FD\u5287\u70C8\u6CE2\u52D5\u3002\r\n\r\n\u751F\u547D\u5FB5\u8C61\uFF1A
      \u56B4\u5BC6\u89C0\u5BDF\u5FC3\u5F8B\u8B8A\u5316\uFF08\u4F4E\u6EAB\u53EF\u80FD\u5C0E\u81F4\u5FC3\u8DF3\u904E\u7DE9\uFF09\u3002\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u500B\u6848\uFF1A\u59D3\u540D\uFF1A\u5F35\u5C0F\u540D\r\n\u7537\u6027
      52\u6B72\uFF08\u751F\u65E5\uFF1A62\u5E747\u670812\u65E5\uFF09\r\n170\u516C\u5206\u300165\u516C\u65A4\r\n52\u6B72\u7537\u6027\u6709\u9577\u671F\u9AD8\u8840\u58D3\uFF0C\u6C92\u6709\u5403\u85E5\u63A7\u5236\uFF0C\u56E0\u70BA\u65E9\u4E0A\u5341\u500D\u767C\u73FE\u5728\u5E8A\u4E0A\u53EB\u4E0D\u9192\u88AB\u4EBA\u53EB119\u9001\u5230\u91AB\u9662\u6025\u8A3A\r\n\u96FB\u8166\u65B7\u5C64\u8A3A\u65B7\uFF1A\u51FA\u8840\u6027\u4E2D\u98A8\r\n\u5728\u6025\u8A3A\u6642\u75C5\u4EBA\u683C\u62C9\u65AF\u54E5\u660F\u8FF7\u6307\u6578(Glasgow
      Coma Scale, GCS)\u70BA11\u5206\uFF0CE3V2M6\r\n\u9AD4\u6EAB36.5\u2103\u3001\u8108\u640F50\u6B21/\u5206\u3001\u547C\u543818\u6B21/\u5206\u3001\u8840\u58D3169/84\u6BEB\u7C73\u6C5E\u67F1\u3001\u8840\u6C27\u6FC3\u5EA696%\r\n\u56DB\u80A2\u808C\u8089\u529B\u91CF\u7686\u70BA4\u5206\r\n\u56E0\u51FA\u8840\u91CF\u8F03\u5927\u5C0E\u81F4\u75C5\u4EBA\u610F\u8B58\u5DEE\uFF08GCS11\u5206\uFF09\u8207\u5BB6\u5C6C\u89E3\u91CB\u5F8C\u540C\u610F\u9032\u884C\u624B\u8853\u53D6\u51FA\u8840\u584A\uFF0C\u624B\u8853\u5F8C\u70BAGCS
      E3VTM4\uFF0C\u76E3\u6E2C\u9871\u5167\u58D3\u70BA8\u81F317mmHg\r\n\r\n\u624B\u8853\u5F8C\u7B2C\u4E8C\u5929\uFF0C\u500B\u6848\u9871\u5167\u58D3\u4E0A\u5347\u81F325\u81F332mmHg\uFF0CGCS\u70BAE1VTM4\uFF0C\u9AD4\u6EAB37.8\u2103\u3001\u8108\u640F52\u6B21/\u5206\u3001\u547C\u543815\u6B21/\u5206\u3001\u8840\u58D3178/88mmHg\uFF0C\u77B3\u5B54\u5149\u53CD\u5C04\u6B63\u5E38\uFF0C\u56DB\u80A2\u808C\u8089\u529B\u91CF\u53F3\u4E0A\u80A2\u808C\u529B2\u5206\u3001\u53F3\u4E0B\u80A2\u808C\u529B3\u5206\u3001\u5DE6\u5074\u80A2\u9AD4\u808C\u529B4\u5206\uFF0C\u518D\u6B21\u5B89\u6392\u982D\u90E8\u96FB\u8166\u65B7\u5C64\u986F\u793A\u5DE6\u5074\u984D\u9873\u8449\u8166\u51FA\u8840\u64F4\u5927\u4F75\u4E2D\u7DDA\u504F\u79FB\u3002\r\n\r\n\u8ABF\u6574\u964D\u8166\u58D3\u85E5\u7269Glycerin\u70BA\u6BCF
      3\u5C0F\u6642\u975C\u8108\u8F38\u6CE8 200ml\u4F46\u9871\u5167\u58D3\u4ECD\u672A\u964D\u4F4E\uFF0C\u7D93\u5BB6\u5C6C\u540C\u610F\u5F8C\u65BD\u4EE5\u5DE6\u5074\u984D\u9873\u9802\u9AA8\u6E1B\u58D3\u6027\u9871\u9AA8\u5207\u9664\u624B\u8853\u53CA\u653E\u7F6E\u8166\u5BA4\u5916\u5F15\u6D41\u7BA1\u3001\u5F15\u6D41\u9806\u66A2\u5F15\u6D41\u6DB2\u5448\u73FE\u7D05\u8272\u8840\u6C34\uFF0C\u9871\u5167\u58D3\u4ECD\u7DAD\u630125\u81F327mmHg\u3001\u8166\u704C\u6CE8\u58D3\u70BA56\u81F362mmHg\u3002\r\n\u8A3A\u65B7\u51FA\u8840\u6027\u4E2D\u98A8\u5408\u4F75\u96E3\u6CBB\u578B\u9871\u5167\u9AD8\u58D3\u3002\u8207\u5BB6\u5C6C\u8A0E\u8AD6\u5F8C\u6C7A\u5B9A\u4F7F\u7528\u4F4E\u6EAB\u6CBB\u7642\u964D\u4F4E\u9871\u5167\u9AD8\u58D3\r\n\r\n\r\n"
